// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum BilagStatus {
  MANGLER_BELOEB
  BOGFOERT
  IGNORERET
}

model BusinessArea {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Category {
  id           String           @id @default(cuid())
  name         String
  type         TransactionType
  createdAt    DateTime         @default(now())
  transactions Transaction[]

  @@unique([name, type])
}

model Transaction {
  id             String           @id @default(cuid())
  date           DateTime
  amount         Float
  type           TransactionType
  description    String?
  source         String           @default("MANUAL")
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId     String?
  businessArea   BusinessArea?    @relation(fields: [businessAreaId], references: [id], onDelete: SetNull)
  businessAreaId String?
  bilag          Bilag?
  createdAt      DateTime         @default(now())

  @@index([date])
  @@index([categoryId])
  @@index([businessAreaId])
}

model Bilag {
  id                String      @id @default(cuid())
  emailMessageId    String      @unique
  emailThreadId     String
  receivedAt        DateTime
  senderEmail       String
  subject           String
  attachmentNames   String
  snippet           String?
  guessedVendor     String?
  guessedAmount     Float?
  guessedInvoiceDate DateTime?
  status            BilagStatus @default(MANGLER_BELOEB)
  transaction       Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  transactionId     String?      @unique
  attachments       BilagAttachment[]
  createdAt         DateTime    @default(now())

  @@index([status])
  @@index([receivedAt])
}

model BilagAttachment {
  id          String   @id @default(cuid())
  bilag       Bilag    @relation(fields: [bilagId], references: [id], onDelete: Cascade)
  bilagId     String
  filename    String
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())

  @@index([bilagId])
}

model LoginAttempt {
  id          String   @id @default(cuid())
  ipAddress   String
  success     Boolean
  createdAt   DateTime @default(now())

  @@index([ipAddress, createdAt])
}
