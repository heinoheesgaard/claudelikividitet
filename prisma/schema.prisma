// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum BilagStatus {
  MANGLER_BELOEB
  BOGFOERT
  IGNORERET
  AFSTEMT
}

model BusinessArea {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Category {
  id           String           @id @default(cuid())
  name         String
  type         TransactionType
  createdAt    DateTime         @default(now())
  transactions Transaction[]

  @@unique([name, type])
}

model Transaction {
  id             String           @id @default(cuid())
  date           DateTime
  amount         Float
  type           TransactionType
  description    String?
  source         String           @default("MANUAL")
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId     String?
  businessArea   BusinessArea?    @relation(fields: [businessAreaId], references: [id], onDelete: SetNull)
  businessAreaId String?
  bilag          Bilag?
  createdAt      DateTime         @default(now())

  @@index([date])
  @@index([categoryId])
  @@index([businessAreaId])
}

model Bilag {
  id                String      @id @default(cuid())
  emailMessageId    String      @unique
  emailThreadId     String
  receivedAt        DateTime
  senderEmail       String
  subject           String
  attachmentNames   String
  snippet           String?
  bodyText          String?
  guessedVendor     String?
  guessedCvr        String?
  guessedAmount     Float?
  guessedCurrency   String?
  guessedInvoiceDate DateTime?
  status            BilagStatus @default(MANGLER_BELOEB)
  transaction       Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  transactionId     String?      @unique
  attachments       BilagAttachment[]
  bankPosting       BankPosting?
  createdAt         DateTime    @default(now())

  @@index([status])
  @@index([receivedAt])
  @@index([guessedCvr])
}

model BilagAttachment {
  id          String   @id @default(cuid())
  bilag       Bilag    @relation(fields: [bilagId], references: [id], onDelete: Cascade)
  bilagId     String
  filename    String
  contentType String
  // Historically the raw file lived here — every read and write sent the
  // full bytes through the Postgres connection, which is what blew through
  // Neon's free-tier monthly network transfer allowance. New attachments go
  // to Vercel Blob instead (blobPathname set, data left null); attachments
  // stored before this change keep their bytes here until backfilled.
  data         Bytes?
  blobPathname String?
  createdAt    DateTime @default(now())

  @@index([bilagId])
}

enum BankPostingStatus {
  PENDING
  CONFIRMED
  NO_BILAG_NEEDED
}

// One row per uploaded bank statement line, persisted so reconciliation
// survives leaving the page — upload once, come back over days or weeks and
// pick up wherever you left off instead of re-uploading and starting over.
model BankPosting {
  id               String            @id @default(cuid())
  date             DateTime
  text             String
  amount           Float
  status           BankPostingStatus @default(PENDING)
  matchedBilag     Bilag?            @relation(fields: [matchedBilagId], references: [id], onDelete: SetNull)
  matchedBilagId   String?           @unique
  // Bilag a human has already said "no" to for this posting — excluded from
  // future match suggestions so rejecting one doesn't just show it again.
  rejectedBilagIds String[]          @default([])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Bank exports have no row ID of their own — this is the dedup key so
  // re-uploading an overlapping period (this week's file includes some of
  // last week's rows again) doesn't create duplicate postings.
  @@unique([date, text, amount])
  @@index([status])
  @@index([date])
}

// Caches CVR-number → registered company name lookups against the public
// cvrapi.dk registry, so the same recurring vendor (the same supermarket,
// week after week) doesn't trigger a fresh external API call on every OCR
// pass — and so a vendor with no CVR match doesn't get re-queried forever.
model CvrLookup {
  id         String   @id @default(cuid())
  cvr        String   @unique
  name       String?
  // The user's own correction of the registered legal name — e.g. the
  // recognizable trade name ("MENY Vorupør") in place of the legal entity
  // behind it ("A/S G. Hillgaard") — set once and preferred over `name` for
  // every bilag sharing this CVR from then on, including ones already
  // booked before the correction was made.
  alias      String?
  lookedUpAt DateTime @default(now())
}

// A large manual "Hent bilag nu" run can span far more pages than a single
// serverless invocation's time limit allows. Persisting progress here lets
// the server resume itself (see src/lib/sync-job.ts) purely by chaining
// requests to itself with `after()`, so the job keeps going to completion
// regardless of whether the browser that started it is still open,
// foregrounded, or even on the same continent.
model SyncJob {
  id             String   @id @default(cuid())
  days           Int
  pageToken      String?
  totalCreated   Int      @default(0)
  totalProcessed Int      @default(0)
  active         Boolean  @default(true)
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active])
}

model LoginAttempt {
  id          String   @id @default(cuid())
  ipAddress   String
  success     Boolean
  createdAt   DateTime @default(now())

  @@index([ipAddress, createdAt])
}
